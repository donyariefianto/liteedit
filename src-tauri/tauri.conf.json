{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 800,
        "minHeight": 600,
        "minWidth": 800,
        "title": "LiteEdit",
        "width": 1280
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 LiteEdit contributors",
    "shortDescription": "LiteEdit — editor kode super ringan (Tauri + Rust)",
    "longDescription": "LiteEdit adalah editor kode desktop super ringan ala VS Code untuk Windows: multi-tab + syntax highlighting (CodeMirror 6), terminal terintegrasi (PTY asli), panel Git, dan pencarian global.",
    "license": "MIT",
    "licenseFile": "../LICENSE-MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.liteedit.app",
  "productName": "LiteEdit",
  "version": "0.2.0"
}
